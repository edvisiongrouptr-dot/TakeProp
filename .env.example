# Example environment variables for development
# Copy to .env and fill values before running

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/takeprop?schema=public
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace_me_with_strong_secret
NODE_ENV=development
PORT=3000
WEB_PORT=3001
FEATURE_FLAGS_FREE_TRIAL_ENABLED=true
FEATURE_FLAGS_PAID_CHECKOUT_ENABLED=true
FEATURE_FLAGS_PAYOUTS_ENABLED=true
FOUNDING_EDITION_CAP=100

# Server-only production operations. Never prefix these with NEXT_PUBLIC_.
HEALTHCHECK_SECRET=replace_with_32_or_more_random_characters
CRON_SECRET=replace_with_32_or_more_random_characters
EMAIL_WORKER_SECRET=replace_with_32_or_more_random_characters
ORDER_WORKER_SECRET=replace_with_32_or_more_random_characters
PAYMENT_WORKER_SECRET=replace_with_32_or_more_random_characters
PAYMENT_VERIFICATION_API_URL=https://your-verification-provider.example/v1/verify-usdt
PAYMENT_VERIFICATION_API_TOKEN=replace_me
RESEND_API_KEY=re_replace_me
EMAIL_FROM=TakeProp <operations@example.com>
ALERT_WEBHOOK_URL=
