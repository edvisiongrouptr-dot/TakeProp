generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  firstName String?
  lastName  String?
  email     String   @unique
  password  String
  roles     UserRole[]
  accounts  TradingAccount[]
}

model UserRole {
  id   String @id @default(cuid())
  user User   @relation(fields:[userId], references:[id])
  userId String
  role  String
}

model Product {
  id    String @id @default(cuid())
  name  String
  price Int
}

model TradingAccount {
  id        String   @id @default(cuid())
  user      User     @relation(fields:[userId], references:[id])
  userId    String
  type      String
  balance   Decimal  @db.Decimal(28,8) @default(0)
}

model Instrument {
  id     String @id @default(cuid())
  symbol String @unique
  active Boolean @default(true)
}

model LedgerEntry {
  id        String   @id @default(cuid())
  account   TradingAccount @relation(fields:[accountId], references:[id])
  accountId String
  amount    Decimal  @db.Decimal(28,8)
  type      String
  createdAt DateTime @default(now())
  metadata  Json?
}
