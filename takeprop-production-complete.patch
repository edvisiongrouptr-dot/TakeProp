+'use client'
+import { useState } from 'react'
+import { useRouter } from 'next/navigation'
+import styles from './admin.module.css'
+export default function PayoutActions({id,status}:{id:string;status:string}){const router=useRouter(),[busy,setBusy]=useState(false),[error,setError]=useState('');async function act(decision:string){let reason='',providerPayoutId='';if(decision==='reject'){reason=prompt('Rejection reason')||'';if(!reason)return}if(decision==='mark_paid'){providerPayoutId=prompt('Blockchain payout transaction hash')||'';if(!providerPayoutId)return}if(!confirm(`Confirm ${decision.replace('_',' ')}?`))return;setBusy(true);setError('');const r=await fetch(`/api/admin/payouts/${id}/review`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({decision,reason,providerPayoutId})});const j=await r.json().catch(()=>({}));setBusy(false);if(!r.ok){setError(j.error||'Review failed');return}router.refresh()}return <div className={styles.actions}>{status==='requested'&&<><button disabled={busy} onClick={()=>act('approve')}>Approve</button><button disabled={busy} onClick={()=>act('reject')}>Reject</button></>}{status==='approved'&&<button disabled={busy} onClick={()=>act('mark_processing')}>Mark processing</button>}{status==='processing'&&<button disabled={busy} onClick={()=>act('mark_paid')}>Mark paid</button>}{error&&<p>{error}</p>}</div>}
