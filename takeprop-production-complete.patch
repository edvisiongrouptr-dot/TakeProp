+export async function POST(request:NextRequest,{params}:{params:{id:string}}){const auth=await getAuthenticatedUser();if(!auth)return NextResponse.json({error:'Unauthorized'},{status:401});try{const body=await request.json();const result=await postOwnData('rpc/admin_review_payout',auth.accessToken,{p_request_id:params.id,p_decision:body.decision,p_reason:body.reason||null,p_provider_payout_id:body.providerPayoutId||null});return NextResponse.json(result)}catch(error){return NextResponse.json({error:error instanceof Error?error.message:'Payout review failed'},{status:400})}}
