+'use client'
+import { FormEvent,useState } from 'react'
+export default function SupportForm(){const [busy,setBusy]=useState(false),[message,setMessage]=useState('');async function submit(e:FormEvent<HTMLFormElement>){e.preventDefault();setBusy(true);setMessage('');const form=e.currentTarget,data=new FormData(form),response=await fetch('/api/support',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(Object.fromEntries(data))}),result=await response.json().catch(()=>({}));setBusy(false);if(!response.ok){setMessage(result.error||'Unable to create ticket');return}setMessage(`Ticket ${String(result.ticketId).slice(0,8).toUpperCase()} created.`);form.reset()}return <form onSubmit={submit}><label>Subject<input name="subject" minLength={5} maxLength={120} required/></label><label>Category<select name="category" required><option value="account">Account</option><option value="payment">Payment</option><option value="trading">Trading</option><option value="risk">Risk event</option><option value="payout">Payout</option><option value="kyc">KYC</option><option value="technical">Technical</option><option value="other">Other</option></select></label><label>Message<textarea name="message" minLength={3} maxLength={5000} rows={7} required/></label><button disabled={busy}>{busy?'Sending…':'Create support ticket →'}</button>{message&&<p>{message}</p>}</form>}
